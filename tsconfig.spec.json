{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // the base tsconfig strips comments and disables source maps; without maps jest's
    // coverage lines point into the comment-stripped output and land on the wrong source lines
    "sourceMap": true,
    "removeComments": false,
    // same as the app build (angular.json): a locally linked @sunbird-cb package must take
    // rxjs and other dependencies from this project, not from the folder it links to
    "preserveSymlinks": true,
    "types": [
      "jest",
      "node"
    ]
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
