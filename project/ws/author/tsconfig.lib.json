{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "declaration": false,
    "declarationMap": false,

    "sourceMap": false,
    "inlineSources": false,
    "skipLibCheck": true,
    "traceResolution": true,

    "types": [],
    "paths": {
      "@ws/author": [],
      "@ws/author/*": []
    },
    "lib": ["ES2022", "DOM"]  // Add explicit lib
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "enableIvy": true
  },
  "exclude": ["src/test.ts", "**/*.spec.ts", "node_modules"]
}