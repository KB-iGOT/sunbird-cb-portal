{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",  // Changed from "node16"

    "declaration": true,
    "declarationMap": true,  // Enable this

    "sourceMap": true,  // Consider enabling for debugging
    "inlineSources": false,
    "skipLibCheck": true,

    "types": [],
    "lib": ["ES2022", "DOM"]  // Add explicit lib
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "enableIvy": true,
    "strictTemplates": true  // Consider adding
  },
  "exclude": ["src/test.ts", "**/*.spec.ts", "node_modules"]
}